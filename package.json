{
  "name": "veil-vpn-win11",
  "version": "1.0.0",
  "description": "VEIL VPN — Windows 11 Optical Glass Desktop VPN Client powered by sing-box & Wintun",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "fetch-core": "node scripts/fetch-core.mjs",
    "dist:win": "npm run gen-icon && npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
