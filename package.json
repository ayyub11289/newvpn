{
  "name": "veil-vpn-win11",
  "version": "1.2.3",
  "author": "VEIL Network",
  "description": "VEIL VPN — Windows 11 Optical Glass Desktop VPN Client powered by sing-box 1.14 & Wintun",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "fetch-core": "node scripts/fetch-core.mjs",
    "verify-core-config": "node scripts/verify-singbox-config.mjs",
    "test": "node --test scripts/test-security-regressions.mjs",
    "dist:win": "npm run gen-icon && npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.0.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "misans": "^5.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
